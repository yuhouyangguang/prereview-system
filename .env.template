# ================================================================
# 公司业务预审系统 · 环境配置模板
# 复制为 .env 并填写对应值，.env 不应提交到版本控制
# ================================================================

# ── Z.AI (智谱 GLM) ───────────────────────────────────────────────
# 获取 API Key：https://open.bigmodel.cn/usercenter/apikeys
ZAI_API_KEY=

# Base URL（默认智谱官方；私有化部署时改为内网地址）
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# 模型名称（推荐 glm-4-plus 兼顾速度与效果，或 glm-4-long 用于长文档）
ZAI_MODEL=glm-4-plus

# ── 企业微信群机器人 ──────────────────────────────────────────────
# 创建方式：企业微信群 → 右上角 → 群机器人 → 添加机器人 → 复制 Webhook 地址
# 留空则不推送企业微信通知
WECHAT_WEBHOOK_URL=

# ── 安全配置 ─────────────────────────────────────────────────────
# 生产环境必须设置为随机长字符串，例如：openssl rand -hex 32
JWT_SECRET_KEY=

# 种子账号初始密码（首次 db.create_all 生效；生产环境务必修改后强制改密）
SEED_PASSWORD=password123

# ── Flask 运行配置 ───────────────────────────────────────────────
# 生产环境设为 production + 0
FLASK_ENV=development
FLASK_DEBUG=1
